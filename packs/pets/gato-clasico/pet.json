    "focus": {
      "sheet": "sprites/focus.png",
      "frames": 4,
      "columns": 4,
      "mode": "loop",
      "fps": 2
    },
    "break": {
      "sheet": "sprites/break.png",
      "frames": 4,
      "columns": 4,
      "mode": "loop",
      "fps": 4
    },
    "alert": {
      "sheet": "sprites/alert.png",
      "frames": 6,
      "columns": 6,
      "mode": "once",
      "fps": 8
    },
    "paused": {
      "sheet": "sprites/paused.png",
      "frames": 1,
      "columns": 1,
      "mode": "loop",
      "fps": 1
    }
  },
  "dialogues": {
    "es": {
      "focusStart": [
        "Miau... me duermo mientras trabajas 🐾",
