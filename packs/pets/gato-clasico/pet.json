      "alert": ["¡Miau miau! ¡Tiempo terminado! ⏰", "¡Desperté! ¡Sesión completada con éxito!"],
      "poke": [
        "¡Ronroneo! Aquí estoy acompañándote 🐾",
        "¡Miau! Concéntrate, que yo te cuido.",
        "Una caricia y seguimos produciendo ❤️"
      ]
    },
    "en": {
      "focusStart": [
        "Meow... sleeping while you work 🐾",
        "Watching you with one eye... time to focus!",
        "Productivity purr activated."
      ],
      "breakStart": [
        "Meow! Time for a good cat stretch 🧘",
        "Well-deserved break... go grab some water!",
        "Great focus block. Rest those paws."
      ],
      "alert": ["Meow meow! Time is up! ⏰", "I'm awake! Session completed successfully!"],
      "poke": [
        "Purrr! Keeping you company 🐾",
